{
  "opencollection": "1.0.0",
  "info": {
    "name": "Account Management Accounts Webhooks API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Returns the public keys used to verify webhook signatures",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.valimail.com/webhooks/keys"
          },
          "docs": "Returns a map of key IDs to base64-encoded Ed25519 public keys."
        }
      ]
    }
  ],
  "bundled": true
}